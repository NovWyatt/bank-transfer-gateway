APP_NAME="Bank Transfer Gateway"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Máy local: MariaDB của Larabox. CI: mysql:8.4. Production: TiDB (cần thêm DB SSL CA).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bank_transfer_gateway
DB_USERNAME=root
DB_PASSWORD=

# Wasmer không có Redis: session, cache, hàng đợi đều dùng driver database.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Webhook gửi tới shop (config/webhooks.php). Chỉ máy dev: true cho phép http:// và localhost
# để thử với examples/webhooks. Production luôn chặn dù đặt true.
WEBHOOKS_ALLOW_PRIVATE_TARGETS=false

# Nút "Giả lập khách chuyển khoản" và lệnh pay:simulate (config/payments.php). Shop nhận tiền thật nên đặt false.
PAYMENTS_SIMULATOR=true

# Đường /internal/* (config/internal.php). Để trống thì đường đó trả 404.
# Sinh: php -r "echo bin2hex(random_bytes(32));". Tick dùng chung với secret TICK_SECRET của Worker edge/.
INTERNAL_TICK_SECRET=
INTERNAL_DEPLOY_SECRET=

# Bot Telegram (config/services.php). Tạo bot qua @BotFather; username không có @.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
