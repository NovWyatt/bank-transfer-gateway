includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    # Đọc thân hàm casts() để biết kiểu cast thật (mặc định Larastan chỉ đọc kiểu trả về khai báo).
    parseModelCastsMethod: true
